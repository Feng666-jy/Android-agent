datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  email     String   @unique
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DeepseekModel {
  id          Int      @id @default(autoincrement())
  modelName   String
  displayName String
  apiProvider String
  status      Int      @default(1)
  sort        Int      @default(0)
  createTime  DateTime @default(now())
  updateTime  DateTime @updatedAt
}

model ClaudeModel {
  id          Int      @id @default(autoincrement())
  modelName   String
  displayName String
  apiProvider String
  status      Int      @default(1)
  sort        Int      @default(0)
  createTime  DateTime @default(now())
  updateTime  DateTime @updatedAt
}

model ChatgptModel {
  id          Int      @id @default(autoincrement())
  modelName   String
  displayName String
  apiProvider String
  status      Int      @default(1)
  sort        Int      @default(0)
  createTime  DateTime @default(now())
  updateTime  DateTime @updatedAt
}