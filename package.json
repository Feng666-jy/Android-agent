{
    "name":  "android-agent",
    "version":  "1.0.0",
    "private":  true,
    "type":  "module",
    "scripts":  {
                    "dev:all":  "node scripts/init-db.cjs \u0026\u0026 concurrently \"npm run dev\" \"npm run server\"",
                    "server":  "tsx watch server/src/index.ts",
                    "lint":  "eslint . --fix",
                    "type-check":  "vue-tsc --noEmit",
                    "db:studio":  "prisma studio",
                    "format":  "prettier --write .",
                    "build":  "vue-tsc --noEmit \u0026\u0026 vite build",
                    "db:generate":  "prisma generate",
                    "db:migrate":  "prisma migrate dev",
                    "db:push":  "prisma db push",
                    "db:init":  "node scripts/init-db.cjs",
                    "dev":  "vite",
                    "prepare":  "husky",
                    "preview":  "vite preview",
                    "server:build":  "tsc -p server/tsconfig.json"
                },
    "dependencies":  {
                         "@prisma/client":  "^5.22.0",
                         "@vant/use":  "^1.6.0",
                         "axios":  "^1.7.0",
                         "bcryptjs":  "^2.4.3",
                         "cors":  "^2.8.5",
                         "dayjs":  "^1.11.0",
                         "dotenv":  "^16.4.0",
                         "express":  "^4.19.0",
                         "helmet":  "^7.1.0",
                         "jsonwebtoken":  "^9.0.0",
                         "morgan":  "^1.10.0",
                         "pinia":  "^2.1.0",
                         "vant":  "^4.8.0",
                         "vue":  "^3.4.0",
                         "vue-router":  "^4.3.0",
                         "zod":  "^3.23.0"
                     },
    "devDependencies":  {
                            "@types/bcryptjs":  "^2.4.6",
                            "@types/cors":  "^2.8.17",
                            "@types/express":  "^4.17.21",
                            "@types/jsonwebtoken":  "^9.0.6",
                            "@types/morgan":  "^1.9.9",
                            "@types/node":  "^20.12.0",
                            "@typescript-eslint/eslint-plugin":  "^7.0.0",
                            "@typescript-eslint/parser":  "^7.0.0",
                            "@vitejs/plugin-vue":  "^5.0.0",
                            "concurrently":  "^10.0.3",
                            "eslint":  "^8.57.0",
                            "eslint-config-prettier":  "^9.1.0",
                            "eslint-plugin-vue":  "^9.26.0",
                            "husky":  "^9.0.0",
                            "lint-staged":  "^15.2.0",
                            "prettier":  "^3.2.0",
                            "prisma":  "^5.22.0",
                            "sass":  "^1.77.0",
                            "tsx":  "^4.10.0",
                            "typescript":  "^5.4.0",
                            "vite":  "^5.2.0",
                            "vue-tsc":  "^2.0.0"
                        },
    "lint-staged":  {
                        "*.{vue,ts,js}":  [
                                              "eslint --fix",
                                              "prettier --write"
                                          ]
                    }
}