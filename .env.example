# Server
PORT=3000
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Secret encryption key (AES-256-GCM, for Provider apiKeyEncrypted at-rest encryption)
# 64 hex chars recommended; falls back to JWT_SECRET-derived key if unset
API_KEY_SECRET=your-64-hex-char-encryption-key-change-in-production

# Database (MySQL)
DATABASE_URL="mysql://root:password@localhost:3306/android_agent"

# Frontend
VITE_API_BASE_URL=/api